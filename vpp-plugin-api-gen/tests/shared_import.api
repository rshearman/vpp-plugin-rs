option version = "1.0.0";

/* Both of these import shared_import/types.api */
import "shared_import/a.api";
import "shared_import/b.api";
/* As does this file, twice */
import "shared_import/types.api";
import "shared_import/types.api";

autoreply autoendian define shared_import_message {
