#! /bin/bash

asan=false
if [ "$1" = "--asan" ]; then
    asan=true
    shift
fi

if [ $# -gt 1 ]; then
    echo "Usage: $0 [--asan] [<vpp-ws-dir>]" >&2
    exit 1
fi

# Without a workspace, the system-installed vpp is used
vpp_args=()
if [ -n "$1" ]; then
    vpp_args=(--vpp-tag=vpp --vpp-ws-dir="$1")
fi

if $asan; then
    export RUSTFLAGS="-Zsanitizer=address"
    export RUSTDOCFLAGS="-Zsanitizer=address"
    # Note: requires nightly - `rustup default nightly`
    host=$(rustc -vV | sed -n 's/^host: //p')
    if [ -z "$host" ]; then
        echo "Failed to determine rustc host target" >&2
        exit 1
    fi
    # Building with an explicit --target puts the output in a per-target directory
    cargo build -Zbuild-std --target "$host" || exit $?
    target_dir=../target/$host/debug
else
    cargo build || exit $?
    target_dir=../target/debug
fi

if [ ! -d venv ]; then
    python3 -mvenv venv || exit $?

    source venv/bin/activate

    pip install --upgrade pip || exit $?
    pip install -r tests/requirements.txt || exit $?
else
    source venv/bin/activate
fi

cd tests

mkdir -p plugin-libs || exit $?

ln -f "$target_dir"/libvpp_example_plugin.so plugin-libs/example_plugin.so || exit $?
ln -f "$target_dir"/libvpp_test_plugin.so plugin-libs/test_plugin.so || exit $?
ln -f "$target_dir"/libvpp_test_version_mismatch_plugin.so plugin-libs/version_mismatch_plugin.so || exit $?

python3 run_tests.py "${vpp_args[@]}" --filter *.*.* --extern-plugin-dir $(pwd)/plugin-libs/
rc=$?

if [ -n "$OUTPUT_LOGS_ON_FAILURE" ]; then
    shopt -s nullglob
    for failed_log_file in /tmp/vpp-unittest-*-FAILED/log.txt; do
        echo "$failed_log_file:"
        cat "$failed_log_file"
    done
fi

exit $rc
